pipeline {
    agent any

    environment {
        REGISTRY  = '390403852836.dkr.ecr.us-east-1.amazonaws.com'
        IMAGE     = "${REGISTRY}/demo-app"
        VERSION   = "1.0.${BUILD_NUMBER}"
        AWS_DEFAULT_REGION = 'us-east-1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh 'docker build --platform linux/amd64 --target test .'
            }
        }

        stage('Build') {
            steps {
                sh 'docker build --platform linux/amd64 --target runtime -t $IMAGE:$VERSION .'
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-jenkins']]) {
                    sh '''
                        aws ecr get-login-password | docker login --username AWS --password-stdin $REGISTRY
                        docker push $IMAGE:$VERSION
                    '''
                }
            }
        }

        stage('Trigger deploy') {
            steps {
                build job: 'demo-app-cd',
                    parameters: [string(name: 'VERSION', value: env.VERSION)],
                    wait: false
                }
            }
    }

    post {
        success { echo "Pushed $IMAGE:$VERSION" }
    }
}